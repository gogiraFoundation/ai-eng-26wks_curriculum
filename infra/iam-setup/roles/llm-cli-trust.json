{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ResearchUserMayAssume",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::123456789012:root"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::123456789012:user/iam-user@example.com"
        }
      }
    }
  ]
}
