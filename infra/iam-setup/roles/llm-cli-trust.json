{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ResearchUserMayAssume",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::__AWS_ACCOUNT_ID__:root"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": "__AWS_IAM_USER_ARN__"
        }
      }
    }
  ]
}
