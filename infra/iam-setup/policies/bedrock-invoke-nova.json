{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeNovaThroughEuProfile",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:eu-north-1:__AWS_ACCOUNT_ID__:inference-profile/eu.amazon.nova-micro-v1:0",
        "arn:aws:bedrock:eu-north-1:__AWS_ACCOUNT_ID__:inference-profile/eu.amazon.nova-lite-v1:0",
        "arn:aws:bedrock:*::foundation-model/amazon.nova-micro-v1:0",
        "arn:aws:bedrock:*::foundation-model/amazon.nova-lite-v1:0"
      ]
    }
  ]
}
